{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackgroundVerification": {
    "DefaultCheckLevel": "Standard",
    "ReportPath": "Reports"
  },
  "DocumentUpload": {
    "DocumentFolderPath": "Documents",
    "MaxFileSizeInBytes": 10485760
  }
  ,
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ModelName": "llama2",
    "MaxRetries": 3,
    "RetryDelayMs": 500
  },
  "FraudDetection": {
    "MandatoryDocumentNames": [ "Aadhaar", "PAN", "Resume" ],
    "SuspiciousAadhaarPatterns": [ "^0+$", "^1+$", "^123456789$" ],
    "SuspiciousPanPatterns": [ "^0+$", "^ZZZZZ9999Z$" ],
    "DuplicateDocumentNumberThreshold": 2
  },
  "RiskScoring": {
    "NameMismatchWeight": 30,
    "DobMismatchWeight": 30,
    "MissingPanWeight": 20,
    "MissingAadhaarWeight": 20,
    "FraudDetectedWeight": 40
  },
  "ModelEvaluation": {
    "OllamaBaseUrl": "http://localhost:11434",
    "TimeoutSeconds": 120,
    "Models": [
      { "DisplayName": "Llama 3.2",  "ModelId": "llama3.2"  },
      { "DisplayName": "Phi-3 Mini", "ModelId": "phi3:mini" }
    ],
    "Weights": {
      "Accuracy": 35,
      "Latency": 20,
      "InferenceTime": 15,
      "Memory": 10,
      "OutputQuality": 20
    }
  }
}
